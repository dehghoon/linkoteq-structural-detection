{
  "spec_version": "0.2",
  "coordinate_space": "source-page",
  "allowed_classes": [
    "column",
    "beam",
    "wall"
  ],
  "required_fields": [
    "annotation_id",
    "source_id",
    "page_id",
    "project_group_id",
    "class_name",
    "box",
    "coordinate_space",
    "spec_version",
    "qa_state"
  ],
  "box": {
    "fields": [
      "xmin",
      "ymin",
      "xmax",
      "ymax"
    ],
    "finite": true,
    "positive_area": true,
    "must_be_within_source_page_bounds": true
  },
  "blocking_flags": [
    "ambiguous-class",
    "ambiguous-presence",
    "overlap-ambiguous"
  ],
  "allowed_edge_flags": [
    "partial",
    "occluded",
    "duplicate-render",
    "low-resolution",
    "scan-noise",
    "faded",
    "compression-artifact"
  ],
  "qa_states": [
    "draft",
    "review-required",
    "adjudication-required",
    "approved",
    "corrected-approved",
    "excluded-ambiguous",
    "needs-reannotation"
  ],
  "wall_rules": {
    "visible_only": true,
    "structural_semantics_required": true,
    "infer_hidden_continuation": false,
    "ambiguous_wall_class_allowed": false,
    "initial_geometry": "tight-axis-aligned-source-page-box"
  },
  "split_rules": {
    "group_key": "project_group_id",
    "disjoint_across_train_val_test": true,
    "exact_cross_split_duplicates_block_release": true,
    "near_cross_split_duplicates_block_release": true
  },
  "compatibility": {
    "v0_1_allowed_classes": [
      "column",
      "beam"
    ],
    "wall_under_v0_1": "reject"
  }
}
